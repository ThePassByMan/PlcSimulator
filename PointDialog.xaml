<Window x:Class="PlcSimulator.PointDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="445" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="20">
  <StackPanel x:Name="PointFields">
   <Label Content="{DynamicResource Address}"/><TextBox x:Name="AddressBox" TextChanged="AddressChanged"/>
   <TextBlock x:Name="MappingPreview" Foreground="#316B6B" Margin="0,1,0,6" TextWrapping="Wrap"/>
   <Label Content="{DynamicResource Name}"/><TextBox x:Name="NameBox"/>
   <UniformGrid Columns="2"><StackPanel><Label Content="{DynamicResource Type}"/><ComboBox x:Name="TypeBox" SelectionChanged="TypeChanged"/></StackPanel>
    <StackPanel><Label Content="{DynamicResource Order}"/><ComboBox x:Name="OrderBox" SelectionChanged="TypeChanged"/></StackPanel></UniformGrid>
   <UniformGrid Columns="2"><StackPanel><Label Content="{DynamicResource Value}"/><TextBox x:Name="ValueBox"/></StackPanel>
    <StackPanel><Label Content="{DynamicResource Interval}"/><TextBox x:Name="IntervalBox"/></StackPanel></UniformGrid>
  </StackPanel>
  <StackPanel x:Name="TimeFields" Visibility="Collapsed"><Label Content="{DynamicResource At}"/><TextBox x:Name="TimeBox"/></StackPanel>
  <TextBlock x:Name="Note" Foreground="#45676A" Margin="0,6" TextWrapping="Wrap"/>
  <TextBlock x:Name="ErrorText" Foreground="#A32F29" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="{DynamicResource Cancel}" IsCancel="True"/><Button Content="{DynamicResource Save}" IsDefault="True" Click="Accept" Style="{StaticResource Accent}"/>
  </StackPanel>
 </StackPanel>
</Window>
